---
import { garments, type GarmentKind } from '../lib/garments';
const { label, title, bg = '#111', fg = '#fff', ratio = 'aspect-[4/5]', garment } = Astro.props as {
  label: string; title: string; bg?: string; fg?: string; ratio?: string; garment?: GarmentKind;
};
---
<article class={`tile reveal ${ratio} p-5 md:p-6 flex flex-col justify-between`} style={`--tile-bg:${bg};--tile-fg:${fg}`}>
  <p class="eyebrow opacity-80 relative z-10">{label}</p>
  {garment && (
    <svg viewBox="0 0 200 240" aria-hidden="true" class="absolute left-1/2 top-[14%] h-[60%] -translate-x-1/2 opacity-90" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" set:html={garments[garment]} />
  )}
  <h3 class="display text-3xl md:text-4xl relative z-10">{title}</h3>
</article>
