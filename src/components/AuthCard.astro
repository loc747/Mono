---
const { eyebrow, title } = Astro.props;
const size = 'text-[clamp(3rem,11vw,7rem)]';
---
<section class="wrap py-14 md:py-24 grid md:grid-cols-12 gap-10">
  <div class="md:col-span-5">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class={`display mt-4 break-words ${size}`}>{title}</h1>
  </div>
  <div class="md:col-span-6 md:col-start-7 w-full max-w-lg">
    <p id="cfg-warning" hidden class="mb-6 border border-ink bg-accent p-4 text-sm" role="alert"></p>
    <slot />
  </div>
</section>
