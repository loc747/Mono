---
import { garments, type GarmentKind } from '../lib/garments';
const { kind, class: cls = '' } = Astro.props as { kind: GarmentKind; class?: string };
---
<svg viewBox="0 0 200 240" aria-hidden="true" class={cls} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" set:html={garments[kind]} />
