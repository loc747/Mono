---
import Base from '../layouts/Base.astro';
import AuthCard from '../components/AuthCard.astro';
import { u } from '../lib/url';
---
<Base title="Sign in" noindex>
  <AuthCard eyebrow="Account" title="Sign in.">
    <button type="button" id="google" class="btn btn-ghost w-full"><svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.1-10.1 7.1-17.5z"/><path fill="#FBBC05" d="M10.5 28.7c-.5-1.4-.8-3-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C.9 16.4 0 20.1 0 24s.9 7.6 2.6 10.8l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.8 2.3-8.4 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg> Continue with Google</button>
    <p class="eyebrow my-8 text-center text-ink/50">or</p>
    <form id="form" class="space-y-7" novalidate>
      <div><label for="email" class="eyebrow">Email</label><input id="email" type="email" autocomplete="email" inputmode="email" required class="field" /></div>
      <div><label for="password" class="eyebrow">Password</label><input id="password" type="password" autocomplete="current-password" required class="field" /></div>
      <button class="btn w-full" type="submit" id="submit">Sign in</button>
      <p id="msg" role="status" class="msg"></p>
    </form>
    <div class="mt-8 flex flex-wrap justify-between gap-3 text-sm">
      <a class="underline underline-offset-4" href={u('/signup/')}>Create an account</a>
      <a class="underline underline-offset-4" href={u('/reset/')}>Forgot password?</a>
    </div>
  </AuthCard>
  <script>
    import { supabase, configured } from '../lib/supabase';
    import { routeAfterLogin, signInWithGoogle, NOT_CONFIGURED } from '../lib/auth';
    const msg = document.getElementById('msg')!;
    const form = document.getElementById('form') as HTMLFormElement;
    const say = (t: string, cls = 'err') => { msg.textContent = t; msg.className = 'msg ' + cls; };
    if (!configured) {
      const w = document.getElementById('cfg-warning')!; w.hidden = false; w.textContent = NOT_CONFIGURED;
    } else {
      routeAfterLogin(); // already signed in, or returning from Google
      supabase!.auth.onAuthStateChange((e) => { if (e === 'SIGNED_IN') routeAfterLogin(); });
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!supabase) return say(NOT_CONFIGURED);
      const btn = document.getElementById('submit') as HTMLButtonElement;
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password') as HTMLInputElement).value;
      if (!email || !password) return say('Enter your email and password.');
      btn.disabled = true; say('Signing in…', 'ok');
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      btn.disabled = false;
      if (error) return say(error.message.includes('Email not confirmed') ? 'Please confirm your email first. Check your inbox.' : 'Incorrect email or password.');
      routeAfterLogin();
    });
    document.getElementById('google')!.addEventListener('click', async () => {
      const { error } = await signInWithGoogle();
      if (error) say(error.message);
    });
  </script>
</Base>
