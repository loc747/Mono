---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tile from '../components/Tile.astro';
const items = [
  ['Style', 'Workwear', '#2b2b2b', '#fff', 'workwear'],
  ['Style', 'Minimal', '#f5f4f0', '#0a0a0a', 'minimal'],
  ['Style', 'Streetwear', '#0a0a0a', '#e5ff3a', 'street'],
  ['Brand', 'Heritage Labels', '#111', '#fff', 'brand'],
  ['Brand', 'Emerging Labels', '#e5ff3a', '#0a0a0a', 'brand'],
  ['Style', 'Tailored', '#444', '#fff', 'minimal'],
  ['Brand', 'Independent', '#0a0a0a', '#fff', 'brand'],
  ['Style', 'Outdoor', '#2b2b2b', '#e5ff3a', 'workwear'],
];
const filters = [['all', 'All'], ['workwear', 'Workwear'], ['minimal', 'Minimal'], ['street', 'Street'], ['brand', 'Brands']];
---
<Base title="Explore" description="Explore styles and brands curated by Mono.">
  <PageHero eyebrow="Explore" title="Every style." intro="An evolving archive of fashion styles and brands. Browse, get curious, and find what feels like you." />
  <section class="wrap py-10 md:py-16">
    <div class="flex gap-2 overflow-x-auto -mx-4 px-4 pb-2 md:flex-wrap" role="group" aria-label="Filter">
      {filters.map(([k, l], i) => (
        <button data-filter={k} aria-pressed={i === 0} class="eyebrow shrink-0 border border-ink px-5 py-3 aria-pressed:bg-ink aria-pressed:text-white transition-colors">{l}</button>
      ))}
    </div>
    <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-6">
      {items.map(([l, t, bg, fg, cat]) => <div data-cat={cat}><Tile label={l} title={t} bg={bg} fg={fg} /></div>)}
    </div>
  </section>
  <script is:inline>
    document.querySelectorAll('[data-filter]').forEach(function (b) {
      b.addEventListener('click', function () {
        var f = b.dataset.filter;
        document.querySelectorAll('[data-filter]').forEach(function (x) { x.setAttribute('aria-pressed', x === b); });
        document.querySelectorAll('[data-cat]').forEach(function (c) { c.hidden = !(f === 'all' || c.dataset.cat === f); });
      });
    });
  </script>
</Base>
