---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tile from '../components/Tile.astro';
const studies = [
  ['Study 01', 'Everyday Utility', '#0a0a0a', '#fff', 'How pockets, closures and layers shape daily wear.'],
  ['Study 02', 'Concrete Tailoring', '#2b2b2b', '#fff', 'Structured silhouettes drawn from the city’s architecture.'],
  ['Study 03', 'Subway Palette', '#e5ff3a', '#0a0a0a', 'A color system built from transit signage and street life.'],
  ['Study 04', 'Brand Grammar', '#f5f4f0', '#0a0a0a', 'How repeated details turn garments into a recognizable brand.'],
  ['Study 05', 'Weather Layers', '#444', '#fff', 'Modular outfits designed for four seasons in one coat.'],
  ['Study 06', 'Fit for Everyone', '#111', '#e5ff3a', 'Sizing and proportion beyond a single standard body.'],
];
---
<Base title="Research" description="Mono’s design research: practical, brandable studies on how people dress.">
  <PageHero eyebrow="Research" title="Studies." intro="Ongoing research and development into practical, brandable design. Each study ends in something wearable." />
  <section id="studies-grid" class="wrap py-12 md:py-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
    {studies.map(([l, t, bg, fg, d]) => (
      <div>
        <Tile label={l} title={t} bg={bg} fg={fg} />
        <p class="mt-3 text-ink/75">{d}</p>
      </div>
    ))}
  </section>
  <script>
    import { hydrateStudies } from '../lib/content';
    hydrateStudies(document.getElementById('studies-grid'));
  </script>
</Base>
