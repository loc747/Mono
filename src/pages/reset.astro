---
import Base from '../layouts/Base.astro';
import AuthCard from '../components/AuthCard.astro';
import { u } from '../lib/url';
---
<Base title="Reset password" noindex>
  <AuthCard eyebrow="Account" title="Reset.">
    <form id="request" class="space-y-7" novalidate>
      <p class="text-ink/75">Enter your email and we’ll send a reset link.</p>
      <div><label for="email" class="eyebrow">Email</label><input id="email" type="email" autocomplete="email" inputmode="email" required class="field" /></div>
      <button class="btn w-full" type="submit">Send reset link</button>
    </form>
    <form id="update" hidden class="space-y-7" novalidate>
      <p class="text-ink/75">Choose a new password.</p>
      <div><label for="pw" class="eyebrow">New password</label><input id="pw" type="password" autocomplete="new-password" required class="field" /></div>
      <button class="btn w-full" type="submit">Update password</button>
    </form>
    <p id="msg" role="status" class="msg mt-6"></p>
    <p class="mt-6 text-sm"><a class="underline underline-offset-4" href={u('/login/')}>Back to sign in</a></p>
  </AuthCard>
  <script>
    import { supabase, configured } from '../lib/supabase';
    import { passwordProblem, NOT_CONFIGURED } from '../lib/auth';
    import { u } from '../lib/url';
    const msg = document.getElementById('msg')!;
    const say = (t: string, cls = 'err') => { msg.textContent = t; msg.className = 'msg mt-6 ' + cls; };
    const req = document.getElementById('request') as HTMLFormElement;
    const upd = document.getElementById('update') as HTMLFormElement;
    if (!configured) { const w = document.getElementById('cfg-warning')!; w.hidden = false; w.textContent = NOT_CONFIGURED; }
    supabase?.auth.onAuthStateChange((e) => { if (e === 'PASSWORD_RECOVERY') { req.hidden = true; upd.hidden = false; } });
    req.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!supabase) return say(NOT_CONFIGURED);
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      await supabase.auth.resetPasswordForEmail(email, { redirectTo: location.origin + u('/reset/') });
      say('If that email has an account, a reset link is on its way.', 'ok'); // same message either way
    });
    upd.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = (document.getElementById('pw') as HTMLInputElement).value;
      const problem = passwordProblem(pw);
      if (problem) return say(problem);
      const { error } = await supabase!.auth.updateUser({ password: pw });
      if (error) return say(error.message);
      say('Password updated. Redirecting…', 'ok');
      setTimeout(() => location.replace(u('/login/')), 1200);
    });
  </script>
</Base>
