---
import Base from '../layouts/Base.astro';
import AuthCard from '../components/AuthCard.astro';
import { u } from '../lib/url';
---
<Base title="Your profile" noindex>
  <AuthCard eyebrow="Account" title="Profile.">
    <p id="welcome" hidden class="mb-8 text-lg">Welcome to Mono. Create your profile to finish setting up your account.</p>
    <form id="form" class="space-y-7" novalidate hidden>
      <div class="flex items-center gap-4" id="avatar-row" hidden>
        <img id="avatar" alt="" class="w-16 h-16 object-cover bg-line" referrerpolicy="no-referrer" />
        <p class="text-sm text-ink/70" id="who"></p>
      </div>
      <div><label for="display_name" class="eyebrow">Display name</label><input id="display_name" maxlength="60" required autocomplete="name" class="field" /></div>
      <div><label for="username" class="eyebrow">Username</label><input id="username" maxlength="20" required autocapitalize="none" autocomplete="username" class="field" aria-describedby="uhint" />
        <p id="uhint" class="mt-2 text-xs text-ink/60">3–20 characters: lowercase letters, numbers, underscore.</p></div>
      <div><label for="bio" class="eyebrow">Bio <span class="text-ink/50 normal-case tracking-normal">(optional)</span></label><textarea id="bio" rows="3" maxlength="300" class="field"></textarea></div>
      <div><label for="avatar_url" class="eyebrow">Avatar image URL <span class="text-ink/50 normal-case tracking-normal">(optional, https)</span></label><input id="avatar_url" type="url" inputmode="url" class="field" /></div>
      <button class="btn w-full sm:w-auto" type="submit" id="save">Save profile</button>
      <p id="msg" role="status" class="msg"></p>
    </form>
    <div id="actions" hidden class="mt-10 flex flex-wrap gap-3">
      <a id="admin-link" hidden class="btn" href={u('/admin/')}>Admin console</a>
      <a class="btn btn-ghost" href={u('/community/#submit')}>Submit a look</a>
      <button id="signout" type="button" class="btn btn-ghost">Sign out</button>
    </div>
  </AuthCard>
  <script>
    import { supabase, configured } from '../lib/supabase';
    import { getSession, getProfile, NOT_CONFIGURED } from '../lib/auth';
    import { safeUrl } from '../lib/dom';
    import { u } from '../lib/url';
    const $ = (id: string) => document.getElementById(id) as any;
    const say = (t: string, cls = 'err') => { $('msg').textContent = t; $('msg').className = 'msg ' + cls; };
    (async () => {
      if (!configured || !supabase) { const w = $('cfg-warning'); w.hidden = false; w.textContent = NOT_CONFIGURED; return; }
      const s = await getSession();
      if (!s) return location.replace(u('/login/'));
      const meta: any = s.user.user_metadata ?? {};
      let p = await getProfile(s.user.id);
      const isNew = !p;
      $('form').hidden = false; $('actions').hidden = false;
      if (isNew) $('welcome').hidden = false;
      $('display_name').value = p?.display_name ?? meta.full_name ?? meta.name ?? '';
      $('username').value = p?.username ?? '';
      $('bio').value = p?.bio ?? '';
      const av = p?.avatar_url ?? safeUrl(meta.avatar_url ?? meta.picture);
      $('avatar_url').value = av ?? '';
      if (av) { $('avatar').src = av; $('avatar-row').hidden = false; }
      $('who').textContent = s.user.email ?? '';
      if (p?.role === 'admin') $('admin-link').hidden = false;

      $('form').addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const display_name = $('display_name').value.trim();
        const username = $('username').value.trim().toLowerCase();
        const bio = $('bio').value.trim();
        const avatar_url = $('avatar_url').value.trim();
        if (!display_name) return say('Display name is required.');
        if (!/^[a-z0-9_]{3,20}$/.test(username)) return say('Username must be 3–20 characters: a–z, 0–9, underscore.');
        if (avatar_url && !safeUrl(avatar_url)) return say('Avatar URL must start with https://');
        $('save').disabled = true; say('Saving…', 'ok');
        const row = { display_name, username, bio: bio || null, avatar_url: avatar_url || null };
        const { error } = isNew && !p
          ? await supabase!.from('profiles').insert({ id: s.user.id, ...row })
          : await supabase!.from('profiles').update(row).eq('id', s.user.id);
        $('save').disabled = false;
        if (error) return say(error.code === '23505' ? 'That username is taken.' : 'Could not save your profile. Please check the fields.');
        p = await getProfile(s.user.id);
        say('Profile saved.', 'ok');
        $('welcome').hidden = true;
        if (p?.role === 'admin') $('admin-link').hidden = false;
        if (avatar_url) { $('avatar').src = avatar_url; $('avatar-row').hidden = false; }
      });
      $('signout').addEventListener('click', async () => { await supabase!.auth.signOut(); location.replace(u('/login/')); });
    })();
  </script>
</Base>
