---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tile from '../components/Tile.astro';
const steps = [['Find', 'Explore styles and brands until something clicks.'], ['Refine', 'Make it yours: fit, color, layers, details.'], ['Share', 'Show your look and inspire someone else.']];
---
<Base title="Community" description="Find your best style and share it with the Mono community.">
  <PageHero eyebrow="Community" title="Your style, shared." intro="Anyone can find their own best fashion. Here’s where you share it." />
  <section class="wrap py-16 md:py-24 grid gap-px bg-line border border-line md:grid-cols-3 mx-auto">
    {steps.map(([t, d], i) => (
      <div class="reveal bg-paper p-8 md:p-10">
        <span class="eyebrow">0{i + 1}</span>
        <h2 class="display text-5xl mt-3">{t}</h2>
        <p class="mt-4 text-ink/75">{d}</p>
      </div>
    ))}
  </section>
  <section id="looks-grid" class="wrap pb-16 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6">
    <Tile label="Featured" title="Look 01" bg="#0a0a0a" />
    <Tile label="Featured" title="Look 02" bg="#e5ff3a" fg="#0a0a0a" />
    <Tile label="Featured" title="Look 03" bg="#2b2b2b" />
    <Tile label="Featured" title="Look 04" bg="#444" />
  </section>
  <section id="submit" class="bg-ink text-white">
    <div class="wrap py-16 md:py-24 grid gap-10 md:grid-cols-2">
      <h2 class="display text-5xl md:text-7xl">Submit<br />your look.</h2>
      <div>
        <div id="submit-gate" class="space-y-5">
          <p class="text-white/75">Sign in and create a profile to share your look. Submissions are reviewed before they appear.</p>
          <a href={u('/login/')} class="eyebrow inline-block bg-accent text-ink px-8 py-4 hover:bg-white transition-colors">Sign in to submit</a>
        </div>
        <form id="submit-form" hidden class="space-y-6 text-white" novalidate>
          <div><label for="s_title" class="eyebrow">Title</label><input id="s_title" maxlength="80" required class="field !text-white !border-white placeholder:!text-white/40" /></div>
          <div><label for="s_desc" class="eyebrow">Tell us about it</label><textarea id="s_desc" rows="3" maxlength="400" class="field !text-white !border-white"></textarea></div>
          <div><label for="s_img" class="eyebrow">Image URL (https, optional)</label><input id="s_img" type="url" inputmode="url" class="field !text-white !border-white" /></div>
          <button class="eyebrow bg-accent text-ink px-8 py-4 w-full sm:w-auto hover:bg-white transition-colors" type="submit">Submit look</button>
          <p id="s_msg" role="status" class="text-sm"></p>
        </form>
      </div>
    </div>
  </section>
  <script>
    import { hydrateLooks } from '../lib/content';
    import { supabase } from '../lib/supabase';
    import { getSession, getProfile } from '../lib/auth';
    import { safeUrl } from '../lib/dom';
    hydrateLooks(document.getElementById('looks-grid'));
    (async () => {
      const s = await getSession();
      if (!s || !supabase) return;
      const p = await getProfile(s.user.id);
      if (!p) return; // profile required before submitting
      document.getElementById('submit-gate')!.hidden = true;
      const form = document.getElementById('submit-form') as HTMLFormElement;
      form.hidden = false;
      const msg = document.getElementById('s_msg')!;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const title = (document.getElementById('s_title') as HTMLInputElement).value.trim();
        const description = (document.getElementById('s_desc') as HTMLTextAreaElement).value.trim();
        const img = (document.getElementById('s_img') as HTMLInputElement).value.trim();
        if (!title) { msg.textContent = 'Please add a title.'; return; }
        if (img && !safeUrl(img)) { msg.textContent = 'Image URL must start with https://'; return; }
        const { error } = await supabase!.from('submissions').insert({ title, description, image_url: img || null, author_name: p.display_name });
        msg.textContent = error ? 'Could not submit. Please try again.' : 'Thanks! Your look is awaiting review.';
        if (!error) form.reset();
      });
    })();
  </script>
</Base>
