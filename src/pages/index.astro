---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
const words = ['Practical', 'Brandable', 'Researched', 'Shared', 'New York'];
---
<Base>
  <section class="wrap pt-12 md:pt-20 pb-16 md:pb-28">
    <p class="eyebrow reveal">Fashion design lab · New York</p>
    <h1 class="display reveal mt-6 text-[clamp(4.5rem,24vw,22rem)] -ml-[0.04em]">Mono</h1>
    <div class="mt-10 md:mt-16 grid gap-8 md:grid-cols-12 items-end">
      <p class="reveal md:col-span-6 text-xl md:text-3xl leading-snug font-medium tracking-tight">
        We research and develop practical, brand-led design — and help anyone find, and share, their best style.
      </p>
      <div class="reveal md:col-span-6 md:justify-self-end flex flex-wrap gap-3">
        <a href={u('/research/')} class="eyebrow bg-ink text-white px-7 py-4 hover:bg-accent hover:text-ink transition-colors">See our research</a>
        <a href={u('/community/')} class="eyebrow border border-ink px-7 py-4 hover:bg-ink hover:text-white transition-colors">Share your style</a>
      </div>
    </div>
  </section>

  <div class="bg-ink text-white py-5 overflow-hidden" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="flex shrink-0">
          {words.map(w => <span class="display text-4xl md:text-6xl px-6 md:px-10 whitespace-nowrap">{w} <span class="text-accent">✦</span></span>)}
        </div>
      ))}
    </div>
  </div>

  <section class="wrap py-20 md:py-32 grid gap-12 md:grid-cols-12">
    <p class="eyebrow md:col-span-3 reveal">What we do</p>
    <div class="md:col-span-9 grid gap-px bg-line border border-line">
      {[
        ['01', 'Research', 'We study silhouettes, fabrics and street-level behavior to learn what people actually wear, and why.'],
        ['02', 'Design & Develop', 'Findings become practical, brandable design systems: clear, wearable and built to scale.'],
        ['03', 'Explore', 'A growing archive of styles and brands from around the world, curated for discovery.'],
        ['04', 'Share', 'Everyone has a best look. Mono is where you find yours and show it to others.'],
      ].map(([n, t, d]) => (
        <a href={t === 'Research' ? u('/research/') : t === 'Explore' ? u('/explore/') : t === 'Share' ? u('/community/') : u('/about/')} class="reveal bg-paper p-6 md:p-10 grid md:grid-cols-[5rem_1fr_2fr] gap-3 md:gap-8 hover:bg-accent transition-colors">
          <span class="eyebrow">{n}</span>
          <h2 class="display text-4xl md:text-5xl">{t}</h2>
          <p class="text-ink/75 md:text-lg">{d}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap pb-20 md:pb-32">
    <div class="flex items-end justify-between gap-6 mb-10">
      <h2 class="display reveal text-5xl md:text-8xl">Selected<br />work</h2>
      <a href={u('/research/')} class="eyebrow underline underline-offset-4 shrink-0 pb-2">All research →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      <Tile label="Study 01" title="Everyday Utility" bg="#0a0a0a" />
      <Tile label="Study 02" title="Concrete Tailoring" bg="#2b2b2b" />
      <Tile label="Study 03" title="Subway Palette" bg="#e5ff3a" fg="#0a0a0a" />
    </div>
  </section>

  <section class="bg-ink text-white">
    <div class="wrap py-20 md:py-32 text-center">
      <p class="eyebrow reveal text-accent">Join Mono</p>
      <h2 class="display reveal mt-6 text-[clamp(2.75rem,10vw,9rem)]">Find your<br />best fit.</h2>
      <a href={u('/community/')} class="reveal mt-12 inline-block eyebrow bg-accent text-ink px-8 py-4 hover:bg-white transition-colors">Enter the community</a>
    </div>
  </section>
</Base>
