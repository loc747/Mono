---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
const field = 'w-full bg-transparent border-0 border-b border-ink py-3 text-base focus:outline-none focus:border-b-2 placeholder:text-ink/40';
---
<Base title="Contact" description="Contact Mono for collaborations, press or to submit your style.">
  <PageHero eyebrow="Contact" title="Say hello." intro="Collaborations, press, or want to share your style? Write to us." />
  <section class="wrap py-12 md:py-20 grid gap-14 md:grid-cols-12">
    <form id="contact-form" class="md:col-span-7 space-y-8" novalidate>
      <div><label for="name" class="eyebrow">Name</label><input id="name" name="name" autocomplete="name" required class={field} /></div>
      <div><label for="email" class="eyebrow">Email</label><input id="email" name="email" type="email" autocomplete="email" inputmode="email" required class={field} /></div>
      <div>
        <label for="topic" class="eyebrow">Topic</label>
        <select id="topic" name="topic" class={field}>
          <option value="collab">Collaboration</option><option value="press">Press</option><option value="submission">Submit my style</option><option value="other">Other</option>
        </select>
      </div>
      <div><label for="msg" class="eyebrow">Message</label><textarea id="msg" name="message" rows="5" required class={field}></textarea></div>
      <button class="eyebrow bg-ink text-white px-8 py-4 hover:bg-accent hover:text-ink transition-colors w-full sm:w-auto" type="submit">Send message</button>
      <p id="form-status" role="status" class="text-sm"></p>
    </form>
    <aside class="md:col-span-4 md:col-start-9 space-y-8">
      <div><p class="eyebrow">Studio</p><p class="mt-2 text-lg">New York, NY</p></div>
      <div><p class="eyebrow">Email</p><a class="mt-2 inline-block text-lg underline underline-offset-4" href="mailto:hello@mono.example.com">hello@mono.example.com</a></div>
    </aside>
  </section>
  <script is:inline>
    (function () {
      var p = new URLSearchParams(location.search).get('topic'), sel = document.getElementById('topic');
      if (p && sel.querySelector('option[value="' + p + '"]')) sel.value = p;
      var f = document.getElementById('contact-form'), s = document.getElementById('form-status');
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!f.checkValidity()) { s.textContent = 'Please complete all fields with a valid email.'; f.reportValidity(); return; }
        var d = new FormData(f);
        location.href = 'mailto:hello@mono.example.com?subject=' + encodeURIComponent('[' + d.get('topic') + '] ' + d.get('name')) + '&body=' + encodeURIComponent(d.get('message') + '\n\n' + d.get('email'));
        s.textContent = 'Opening your email app…';
      });
    })();
  </script>
</Base>
