---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Garment from '../components/Garment.astro';
import { dict, type Lang } from '../i18n/dict';
const { lang } = Astro.props as { lang: Lang };
const d = dict[lang].about;
---
<Base lang={lang} title={d.title} description={d.desc}>
  <PageHero lang={lang} eyebrow={d.eyebrow} title={d.heading} intro={d.intro} />
  <section class="wrap py-16 md:py-28 grid gap-12 md:grid-cols-12">
    <p class="eyebrow md:col-span-3 reveal">{d.approach}</p>
    <div class="md:col-span-9 space-y-px bg-line border border-line">
      {d.principles.map(([t, text], i) => (
        <div class="reveal bg-paper p-6 md:p-10">
          <span class="eyebrow">0{i + 1}</span>
          <h2 class={`display mt-3 text-4xl md:text-6xl`}>{t}</h2>
          <p class="mt-4 max-w-2xl text-ink/75 md:text-lg">{text}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="wrap pb-16 md:pb-28 grid gap-12 md:grid-cols-12">
    <p class="eyebrow md:col-span-3 reveal">{d.whoEyebrow}</p>
    <div class="md:col-span-9 grid gap-px bg-line border border-line md:grid-cols-2">
      <div class="reveal bg-paper p-6 md:p-10">
        <h2 class="display text-4xl md:text-5xl">{d.areTitle}</h2>
        <ul class="mt-6 space-y-3 md:text-lg">{d.are.map((t) => <li class="flex gap-3"><span aria-hidden="true">+</span><span>{t}</span></li>)}</ul>
      </div>
      <div class="reveal bg-paper p-6 md:p-10">
        <h2 class="display text-4xl md:text-5xl text-ink/50">{d.notTitle}</h2>
        <ul class="mt-6 space-y-3 md:text-lg text-ink/70">{d.not.map((t) => <li class="flex gap-3"><span aria-hidden="true">–</span><span>{t}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="wrap pb-16 md:pb-28">
    <p class="eyebrow reveal">{d.processEyebrow}</p>
    <h2 class="display reveal mt-4 text-5xl md:text-8xl">{d.processTitle[0]}<br />{d.processTitle[1]}</h2>
    <ol class="mt-12 grid gap-px bg-line border border-line md:grid-cols-5">
      {d.steps.map(([t, text], i) => (
        <li class="reveal bg-paper p-6">
          <Garment kind={['shirt', 'jacket', 'coat', 'trousers', 'tote'][i]} class="w-14 h-auto" />
          <span class="eyebrow mt-4 block">0{i + 1}</span>
          <h3 class="display text-3xl mt-2">{t}</h3>
          <p class="mt-3 text-ink/75 text-sm">{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap pb-12">
    <div class="bg-ink text-white p-8 md:p-16">
      <p class="eyebrow text-accent">{d.mission}</p>
      <p class="reveal mt-6 text-2xl md:text-5xl font-medium tracking-tight leading-tight max-w-4xl">{d.missionText}</p>
    </div>
  </section>
</Base>
