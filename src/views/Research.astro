---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tile from '../components/Tile.astro';
import { dict, type Lang } from '../i18n/dict';
const { lang } = Astro.props as { lang: Lang };
const d = dict[lang].research;
const meta = [['#0a0a0a', '#fff', 'jacket'], ['#2b2b2b', '#fff', 'coat'], ['#e5ff3a', '#0a0a0a', 'shirt'], ['#f5f4f0', '#0a0a0a', 'tote'], ['#444', '#fff', 'cap'], ['#111', '#e5ff3a', 'trousers']] as const;
---
<Base lang={lang} title={d.title} description={d.desc}>
  <PageHero lang={lang} eyebrow={d.eyebrow} title={d.heading} intro={d.intro} />
  <section id="studies-grid" class="wrap py-12 md:py-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 md:gap-x-6 gap-y-12">
    {d.studies.map((s, i) => (
      <div>
        <Tile label={s.label} title={s.title} bg={meta[i][0]} fg={meta[i][1]} garment={meta[i][2]} />
        <p class="mt-4 text-lg">{s.desc}</p>
        <p class="eyebrow mt-5 text-ink/60">{d.focusLabel}</p>
        <ul class="mt-2 divide-y divide-line border-y border-line">
          {s.focus.map((f) => <li class="py-2 text-sm">{f}</li>)}
        </ul>
      </div>
    ))}
  </section>
  <script>
    import { hydrateStudies } from '../lib/content';
    hydrateStudies(document.getElementById('studies-grid'));
  </script>
</Base>
