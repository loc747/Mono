---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tile from '../components/Tile.astro';
import { dict, type Lang } from '../i18n/dict';
const { lang } = Astro.props as { lang: Lang };
const d = dict[lang].research;
const styles = [['#0a0a0a', '#fff'], ['#2b2b2b', '#fff'], ['#e5ff3a', '#0a0a0a'], ['#f5f4f0', '#0a0a0a'], ['#444', '#fff'], ['#111', '#e5ff3a']];
---
<Base lang={lang} title={d.title} description={d.desc}>
  <PageHero lang={lang} eyebrow={d.eyebrow} title={d.heading} intro={d.intro} />
  <section id="studies-grid" class="wrap py-12 md:py-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
    {d.studies.map(([l, t, text], i) => (
      <div>
        <Tile label={l} title={t} bg={styles[i][0]} fg={styles[i][1]} />
        <p class="mt-3 text-ink/75">{text}</p>
      </div>
    ))}
  </section>
  <script>
    import { hydrateStudies } from '../lib/content';
    hydrateStudies(document.getElementById('studies-grid'));
  </script>
</Base>
