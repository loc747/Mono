---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { dict, type Lang } from '../i18n/dict';
import { lp } from '../lib/url';
const { lang } = Astro.props as { lang: Lang };
const d = dict[lang].home;
const ko = lang === 'ko';
const tileStyles = [['#0a0a0a', '#fff'], ['#2b2b2b', '#fff'], ['#e5ff3a', '#0a0a0a']];
---
<Base lang={lang}>
  <section class="wrap pt-12 md:pt-20 pb-16 md:pb-28">
    <p class="eyebrow reveal">{d.eyebrow}</p>
    <h1 class="display reveal mt-6 text-[clamp(4.5rem,24vw,22rem)] -ml-[0.04em]">Mono</h1>
    <div class="mt-10 md:mt-16 grid gap-8 md:grid-cols-12 items-end">
      <p class="reveal md:col-span-6 text-xl md:text-3xl leading-snug font-medium tracking-tight">{d.lead}</p>
      <div class="reveal md:col-span-6 md:justify-self-end flex flex-wrap gap-3">
        <a href={lp(lang, '/research/')} class="eyebrow bg-ink text-white px-7 py-4 hover:bg-accent hover:text-ink transition-colors">{d.ctaResearch}</a>
        <a href={lp(lang, '/community/')} class="eyebrow border border-ink px-7 py-4 hover:bg-ink hover:text-white transition-colors">{d.ctaShare}</a>
      </div>
    </div>
  </section>

  <div class="bg-ink text-white py-5 overflow-hidden" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="flex shrink-0">
          {d.words.map(w => <span class="display text-4xl md:text-6xl px-6 md:px-10 whitespace-nowrap">{w} <span class="text-accent">✦</span></span>)}
        </div>
      ))}
    </div>
  </div>

  <section class="wrap py-20 md:py-32 grid gap-12 md:grid-cols-12">
    <p class="eyebrow md:col-span-3 reveal">{d.whatWeDo}</p>
    <div class="md:col-span-9 grid gap-px bg-line border border-line">
      {d.items.map(([n, t, text, slug]) => (
        <a href={lp(lang, `/${slug}/`)} class="reveal bg-paper p-6 md:p-10 grid md:grid-cols-[5rem_1fr_2fr] gap-3 md:gap-8 hover:bg-accent transition-colors">
          <span class="eyebrow">{n}</span>
          <h2 class={`display ${ko ? 'text-3xl md:text-4xl' : 'text-4xl md:text-5xl'}`}>{t}</h2>
          <p class="text-ink/75 md:text-lg">{text}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap pb-20 md:pb-32">
    <div class="flex items-end justify-between gap-6 mb-10">
      <h2 class={`display reveal ${ko ? 'text-4xl md:text-7xl' : 'text-5xl md:text-8xl'}`}>{d.selected[0]}<br />{d.selected[1]}</h2>
      <a href={lp(lang, '/research/')} class="eyebrow underline underline-offset-4 shrink-0 pb-2">{d.allResearch}</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {d.tiles.map(([label, title], i) => <Tile label={label} title={title} bg={tileStyles[i][0]} fg={tileStyles[i][1]} />)}
    </div>
  </section>

  <section class="bg-ink text-white">
    <div class="wrap py-20 md:py-32 text-center">
      <p class="eyebrow reveal text-accent">{d.joinEyebrow}</p>
      <h2 class={`display reveal mt-6 ${ko ? 'text-[clamp(2.25rem,8vw,7rem)]' : 'text-[clamp(2.75rem,10vw,9rem)]'}`}>{d.joinTitle[0]}<br />{d.joinTitle[1]}</h2>
      <a href={lp(lang, '/community/')} class="reveal mt-12 inline-block eyebrow bg-accent text-ink px-8 py-4 hover:bg-white transition-colors">{d.joinBtn}</a>
    </div>
  </section>
</Base>
