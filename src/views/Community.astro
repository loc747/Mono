---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tile from '../components/Tile.astro';
import { dict, type Lang } from '../i18n/dict';
import { lp } from '../lib/url';
const { lang } = Astro.props as { lang: Lang };
const d = dict[lang].community;
const looks = [['#0a0a0a', '#fff'], ['#e5ff3a', '#0a0a0a'], ['#2b2b2b', '#fff'], ['#444', '#fff']];
---
<Base lang={lang} title={d.title} description={d.desc}>
  <PageHero lang={lang} eyebrow={d.eyebrow} title={d.heading} intro={d.intro} />
  <section class="wrap py-16 md:py-24 grid gap-px bg-line border border-line md:grid-cols-3 mx-auto">
    {d.steps.map(([t, text], i) => (
      <div class="reveal bg-paper p-8 md:p-10">
        <span class="eyebrow">0{i + 1}</span>
        <h2 class="display text-5xl mt-3">{t}</h2>
        <p class="mt-4 text-ink/75">{text}</p>
      </div>
    ))}
  </section>
  <section id="looks-grid" class="wrap pb-16 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6">
    {looks.map(([bg, fg], i) => <Tile label={d.featured} title={`${d.look} 0${i + 1}`} bg={bg} fg={fg} />)}
  </section>
  <section id="submit" class="bg-ink text-white">
    <div class="wrap py-16 md:py-24 grid gap-10 md:grid-cols-2">
      <h2 class="display text-5xl md:text-7xl">{d.submitTitle[0]}<br />{d.submitTitle[1]}</h2>
      <div>
        <div id="submit-gate" class="space-y-5">
          <p class="text-white/75">{d.gate}</p>
          <a href={lp(lang, '/login/')} class="eyebrow inline-block bg-accent text-ink px-8 py-4 hover:bg-white transition-colors">{d.gateBtn}</a>
        </div>
        <form id="submit-form" hidden class="space-y-6 text-white" novalidate>
          <div><label for="s_title" class="eyebrow">{d.fTitle}</label><input id="s_title" maxlength="80" required class="field !text-white !border-white placeholder:!text-white/40" /></div>
          <div><label for="s_desc" class="eyebrow">{d.fDesc}</label><textarea id="s_desc" rows="3" maxlength="400" class="field !text-white !border-white"></textarea></div>
          <div><label for="s_img" class="eyebrow">{d.fImg}</label><input id="s_img" type="url" inputmode="url" class="field !text-white !border-white" /></div>
          <button class="eyebrow bg-accent text-ink px-8 py-4 w-full sm:w-auto hover:bg-white transition-colors" type="submit">{d.fBtn}</button>
          <p id="s_msg" role="status" class="text-sm"></p>
        </form>
      </div>
    </div>
  </section>
  <script>
    import { hydrateLooks } from '../lib/content';
    import { supabase } from '../lib/supabase';
    import { getSession, getProfile } from '../lib/auth';
    import { safeUrl } from '../lib/dom';
    import { msg } from '../lib/i18n';
    hydrateLooks(document.getElementById('looks-grid'));
    (async () => {
      const s = await getSession();
      if (!s || !supabase) return;
      const p = await getProfile(s.user.id);
      if (!p) return; // profile required before submitting
      document.getElementById('submit-gate')!.hidden = true;
      const form = document.getElementById('submit-form') as HTMLFormElement;
      form.hidden = false;
      const out = document.getElementById('s_msg')!;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const m = msg();
        const title = (document.getElementById('s_title') as HTMLInputElement).value.trim();
        const description = (document.getElementById('s_desc') as HTMLTextAreaElement).value.trim();
        const img = (document.getElementById('s_img') as HTMLInputElement).value.trim();
        if (!title) { out.textContent = m.titleReq; return; }
        if (img && !safeUrl(img)) { out.textContent = m.imgBad; return; }
        const { error } = await supabase!.from('submissions').insert({ title, description, image_url: img || null, author_name: p.display_name });
        out.textContent = error ? m.submitFail : m.submitted;
        if (!error) form.reset();
      });
    })();
  </script>
</Base>
