---
import Base from '../layouts/Base.astro';
import AuthCard from '../components/AuthCard.astro';
import GoogleIcon from '../components/GoogleIcon.astro';
import { dict, type Lang } from '../i18n/dict';
import { lp } from '../lib/url';
const { lang } = Astro.props as { lang: Lang };
const a = dict[lang].auth, d = a.login;
---
<Base lang={lang} title={d.title} noindex>
  <AuthCard lang={lang} eyebrow={d.eyebrow} title={d.heading}>
    <button type="button" id="google" class="btn btn-ghost w-full"><GoogleIcon /> {a.google}</button>
    <p class="eyebrow my-8 text-center text-ink/50">{a.or}</p>
    <form id="form" class="space-y-7" novalidate>
      <div><label for="email" class="eyebrow">{a.email}</label><input id="email" type="email" autocomplete="email" inputmode="email" required class="field" /></div>
      <div><label for="password" class="eyebrow">{a.password}</label><input id="password" type="password" autocomplete="current-password" required class="field" /></div>
      <button class="btn w-full" type="submit" id="submit">{d.btn}</button>
      <p id="msg" role="status" class="msg"></p>
    </form>
    <div class="mt-8 flex flex-wrap justify-between gap-3 text-sm">
      <a class="underline underline-offset-4" href={lp(lang, '/signup/')}>{d.create}</a>
      <a class="underline underline-offset-4" href={lp(lang, '/reset/')}>{d.forgot}</a>
    </div>
  </AuthCard>
  <script>
    import { supabase, configured } from '../lib/supabase';
    import { routeAfterLogin, signInWithGoogle } from '../lib/auth';
    import { msg } from '../lib/i18n';
    const out = document.getElementById('msg')!;
    const say = (t: string, cls = 'err') => { out.textContent = t; out.className = 'msg ' + cls; };
    if (!configured) {
      const w = document.getElementById('cfg-warning')!; w.hidden = false; w.textContent = msg().notConfigured;
    } else {
      routeAfterLogin(); // already signed in, or returning from Google
      supabase!.auth.onAuthStateChange((e) => { if (e === 'SIGNED_IN') routeAfterLogin(); });
    }
    document.getElementById('form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const m = msg();
      if (!supabase) return say(m.notConfigured);
      const btn = document.getElementById('submit') as HTMLButtonElement;
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password') as HTMLInputElement).value;
      if (!email || !password) return say(m.enterBoth);
      btn.disabled = true; say(m.signingIn, 'ok');
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      btn.disabled = false;
      if (error) return say(error.message.includes('Email not confirmed') ? m.confirmFirst : m.badLogin);
      routeAfterLogin();
    });
    document.getElementById('google')!.addEventListener('click', async () => {
      const { error } = await signInWithGoogle();
      if (error) say(error.message);
    });
  </script>
</Base>
