---
import Base from '../layouts/Base.astro';
import AuthCard from '../components/AuthCard.astro';
import { dict, type Lang } from '../i18n/dict';
import { lp } from '../lib/url';
const { lang } = Astro.props as { lang: Lang };
const a = dict[lang].auth, d = a.reset;
---
<Base lang={lang} title={d.title} noindex>
  <AuthCard lang={lang} eyebrow={d.eyebrow} title={d.heading}>
    <form id="request" class="space-y-7" novalidate>
      <p class="text-ink/75">{d.ask}</p>
      <div><label for="email" class="eyebrow">{a.email}</label><input id="email" type="email" autocomplete="email" inputmode="email" required class="field" /></div>
      <button class="btn w-full" type="submit">{d.send}</button>
    </form>
    <form id="update" hidden class="space-y-7" novalidate>
      <p class="text-ink/75">{d.choose}</p>
      <div><label for="pw" class="eyebrow">{d.newPw}</label><input id="pw" type="password" autocomplete="new-password" required class="field" /></div>
      <button class="btn w-full" type="submit">{d.update}</button>
    </form>
    <p id="msg" role="status" class="msg mt-6"></p>
    <p class="mt-6 text-sm"><a class="underline underline-offset-4" href={lp(lang, '/login/')}>{d.back}</a></p>
  </AuthCard>
  <script>
    import { supabase, configured } from '../lib/supabase';
    import { passwordProblem } from '../lib/auth';
    import { msg, cl } from '../lib/i18n';
    const out = document.getElementById('msg')!;
    const say = (t: string, cls = 'err') => { out.textContent = t; out.className = 'msg mt-6 ' + cls; };
    const req = document.getElementById('request') as HTMLFormElement;
    const upd = document.getElementById('update') as HTMLFormElement;
    if (!configured) { const w = document.getElementById('cfg-warning')!; w.hidden = false; w.textContent = msg().notConfigured; }
    supabase?.auth.onAuthStateChange((e) => { if (e === 'PASSWORD_RECOVERY') { req.hidden = true; upd.hidden = false; } });
    req.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!supabase) return say(msg().notConfigured);
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      await supabase.auth.resetPasswordForEmail(email, { redirectTo: location.origin + cl('/reset/') });
      say(msg().resetSent, 'ok'); // same message either way
    });
    upd.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = (document.getElementById('pw') as HTMLInputElement).value;
      const problem = passwordProblem(pw);
      if (problem) return say(problem);
      const { error } = await supabase!.auth.updateUser({ password: pw });
      if (error) return say(error.message);
      say(msg().pwUpdated, 'ok');
      setTimeout(() => location.replace(cl('/login/')), 1200);
    });
  </script>
</Base>
