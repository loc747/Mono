---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tile from '../components/Tile.astro';
import { dict, type Lang } from '../i18n/dict';
const { lang } = Astro.props as { lang: Lang };
const d = dict[lang].explore;
const meta = [['#2b2b2b', '#fff', 'workwear'], ['#f5f4f0', '#0a0a0a', 'minimal'], ['#0a0a0a', '#e5ff3a', 'street'], ['#111', '#fff', 'brand'],
  ['#e5ff3a', '#0a0a0a', 'brand'], ['#444', '#fff', 'minimal'], ['#0a0a0a', '#fff', 'brand'], ['#2b2b2b', '#e5ff3a', 'workwear']];
---
<Base lang={lang} title={d.title} description={d.desc}>
  <PageHero lang={lang} eyebrow={d.eyebrow} title={d.heading} intro={d.intro} />
  <section class="wrap py-10 md:py-16">
    <div class="flex gap-2 overflow-x-auto -mx-4 px-4 pb-2 md:flex-wrap" role="group" aria-label={d.filter}>
      {d.filters.map(([k, l], i) => (
        <button data-filter={k} aria-pressed={i === 0} class="eyebrow shrink-0 border border-ink px-5 py-3 aria-pressed:bg-ink aria-pressed:text-white transition-colors">{l}</button>
      ))}
    </div>
    <div id="explore-grid" class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-6">
      {d.items.map(([l, t], i) => <div data-cat={meta[i][2]}><Tile label={l} title={t} bg={meta[i][0]} fg={meta[i][1]} /></div>)}
    </div>
  </section>
  <script is:inline>
    document.querySelectorAll('[data-filter]').forEach(function (b) {
      b.addEventListener('click', function () {
        var f = b.dataset.filter;
        document.querySelectorAll('[data-filter]').forEach(function (x) { x.setAttribute('aria-pressed', x === b); });
        document.querySelectorAll('[data-cat]').forEach(function (c) { c.hidden = !(f === 'all' || c.dataset.cat === f); });
      });
    });
  </script>
  <script>
    import { hydrateArchive } from '../lib/content';
    hydrateArchive(document.getElementById('explore-grid'));
  </script>
</Base>
