---
import { u } from '../lib/url';
import '../styles/global.css';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title, noindex = false, description = 'Mono is a New York–inspired fashion design lab researching practical, brandable design — and helping everyone find and share their best style.' } = Astro.props;
const fullTitle = title ? `${title} — Mono` : 'Mono — Fashion Design Lab, New York';
const path = Astro.url.pathname;
const nav = [
  { href: u('/about/'), label: 'About' },
  { href: u('/research/'), label: 'Research' },
  { href: u('/explore/'), label: 'Explore' },
  { href: u('/community/'), label: 'Community' },
  { href: u('/contact/'), label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-ink focus:text-white focus:px-4 focus:py-2">Skip to content</a>

    <header class="sticky top-0 z-50 bg-paper/85 backdrop-blur border-b border-line" style="padding-top: env(safe-area-inset-top)">
      <div class="wrap flex items-center justify-between h-16">
        <a href={u('/')} class="display text-2xl" aria-label="Mono home">Mono<span class="text-ink">.</span></a>
        <nav aria-label="Primary" class="hidden md:flex gap-8">
          {nav.map(n => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}
               class="eyebrow py-2 border-b-2 border-transparent hover:border-ink aria-[current=page]:border-ink">{n.label}</a>
          ))}
        </nav>
        <div class="hidden md:flex items-center gap-6">
          <a href={u('/login/')} class="eyebrow py-2 border-b-2 border-transparent hover:border-ink" data-account>Sign in</a>
          <a href={u('/contact/')} class="eyebrow bg-ink text-white px-5 py-3 hover:bg-accent hover:text-ink transition-colors">Let’s talk</a>
        </div>
        <button id="menu-btn" class="md:hidden -mr-2 p-3" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
          <span class="block w-6 h-0.5 bg-ink mb-1.5 transition-transform origin-center" data-bar></span>
          <span class="block w-6 h-0.5 bg-ink transition-transform origin-center" data-bar></span>
        </button>
      </div>
    </header>

    <div id="mobile-menu" hidden class="md:hidden fixed inset-0 top-16 z-40 bg-ink text-white overflow-y-auto" style="padding-bottom: env(safe-area-inset-bottom)">
      <nav aria-label="Mobile" class="wrap py-8 flex flex-col">
        {nav.map(n => (
          <a href={n.href} class="display text-5xl py-4 border-b border-white/15 hover:text-accent">{n.label}</a>
        ))}
        <a href={u('/login/')} class="display text-5xl py-4 border-b border-white/15 hover:text-accent" data-account>Sign in</a>
        <p class="eyebrow mt-10 text-white/60">New York · Est. 2025</p>
      </nav>
    </div>

    <main id="main" class="flex-1"><slot /></main>

    <footer class="bg-ink text-white mt-24" style="padding-bottom: env(safe-area-inset-bottom)">
      <div class="wrap py-16 grid gap-12 md:grid-cols-3">
        <div>
          <p class="display text-6xl md:text-7xl">Mono</p>
          <p class="mt-4 text-white/70 max-w-xs">A New York–inspired lab for practical, brandable fashion design.</p>
        </div>
        <nav aria-label="Footer" class="grid grid-cols-2 gap-y-3 content-start">
          {nav.map(n => <a href={n.href} class="eyebrow text-white/80 hover:text-accent py-1">{n.label}</a>)}
        </nav>
        <div class="text-white/70">
          <p class="eyebrow text-white">Studio</p>
          <p class="mt-3">New York, NY</p>
          <a href="mailto:hello@mono.example.com" class="mt-1 inline-block underline underline-offset-4 hover:text-accent">hello@mono.example.com</a>
        </div>
      </div>
      <div class="border-t border-white/15">
        <div class="wrap py-6 flex flex-wrap justify-between gap-2 text-xs text-white/50">
          <span>© {new Date().getFullYear()} Mono. All rights reserved.</span>
          <span>Research · Design · Share</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById('menu-btn'), menu = document.getElementById('mobile-menu');
        var bars = btn.querySelectorAll('[data-bar]');
        function set(open) {
          btn.setAttribute('aria-expanded', open); btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          menu.hidden = !open; document.body.style.overflow = open ? 'hidden' : '';
          bars[0].style.transform = open ? 'translateY(4px) rotate(45deg)' : '';
          bars[1].style.transform = open ? 'translateY(-4px) rotate(-45deg)' : '';
        }
        btn.addEventListener('click', function () { set(menu.hidden); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
        matchMedia('(min-width:768px)').addEventListener('change', function (m) { if (m.matches) set(false); });
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
        var io = new IntersectionObserver(function (es) { es.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: .12 });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
    <script>
      // Swap "Sign in" for "Account" when a session exists (UI only; access is enforced server-side by RLS).
      import { supabase } from '../lib/supabase';
      import { u } from '../lib/url';
      supabase?.auth.getSession().then(({ data }) => {
        if (!data.session) return;
        document.querySelectorAll<HTMLAnchorElement>('[data-account]').forEach((a) => {
          a.textContent = 'Account';
          a.href = u('/profile/');
        });
      });
    </script>
  </body>
</html>
